{
    "editor.tabSize": 4,
    "editor.insertSpaces": true,

    "explorer.compactFolders": false, //ツリーでコンパクト表示しない

    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.formatOnType": false,
    "workbench.panel.defaultLocation": "right",

    "editor.inlayHints.enabled": "offUnlessPressed",
    // "editor.hover.enabled": false, // ホバーを無効化
    // "editor.parameterHints.enabled": false, // 引数ヒント自動表示を無効化

    "editor.hover.enabled": "on", // ホバーを有効化
    "editor.hover.delay": 500, // 少し遅らせて意図しない表示を防ぐ

    // rust-analyzerのホバーから余計な情報を削る
    "rust-analyzer.hover.documentation.enable": false, // ドキュメントを非表示
    "rust-analyzer.hover.actions.enable": false,       // "Go to definition" などのリンクを非表示
    "rust-analyzer.hover.links.enable": false,          // 標準ライブラリへのリンク等を非表示

    "rust-analyzer.lens.enable": false,
    "rust-analyzer.check.extraArgs": ["--target-dir", "target/ra"], //rust-analyzerがcargoコマンドをブロックしないように
    "rust-analyzer.completion.autoimport.enable": false, // 補完候補を選択した際の自動 import を無効にする

    // https://qiita.com/kabechiyo13/items/82f2c97792e01c37dd8b#vs-code%E3%81%AE%E7%92%B0%E5%A2%83%E8%A8%AD%E5%AE%9A
    // "editor.guides.bracketPairs": true,       // 対応している括弧にガイドを表示する
    "editor.minimap.renderCharacters": false, // ミニマップに実際の文字を表示しない
    "editor.renderControlCharacters": true,   // 制御文字を表示する
    "editor.renderLineHighlight": "all",      // 現在の選択行をハイライトする
    "editor.renderWhitespace": "boundary",    // 半角スペースを・で表示する

    "editor.trimAutoWhitespace": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "[markdown]":
    {   "files.trimTrailingWhitespace": false
    },
}